{
  "name": "@app/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app-type": {
      "types": "./dist/dts/app-type.d.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.3",
    "@hono/zod-validator": "^0.8.0",
    "@pkg/shared": "workspace:*",
    "baileys": "7.0.0-rc13",
    "better-auth": "^1.6.11",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.22",
    "nodemailer": "^8.0.7",
    "pg": "^8.21.0",
    "pg-boss": "^12.18.2",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.0",
    "@types/node": "^25.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^4.1.7",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
