  "query": "SELECT p.id AS passkey_id, p.passkey AS \"passkey: Json<Passkey>\",\n            u.id, u.email, u.verified_at, u.created_at, u.updated_at\n        FROM passkeys p JOIN users u ON u.id = p.user_id\n        WHERE p.credential_id = $1\n        FOR UPDATE OF p",
