  "paths": {
    "/api/hello": {
      "get": {
        "summary": "Hello world",
        "operationId": "hello",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
