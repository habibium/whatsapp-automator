{
  "name": "whatsapp-message-scheduler",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter '@app/server' dev",
    "dev:web": "bun --filter '@app/web' dev",
    "build": "bun --filter '*' build",
    "build:server": "bun --filter '@app/server' build",
    "build:web": "bun --filter '@app/web' build",
    "db:generate": "bun --filter '@app/server' db:generate",
    "db:migrate": "bun --filter '@app/server' db:migrate",
    "biome": "biome check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "typescript": "^5.9.3"
  }
}
