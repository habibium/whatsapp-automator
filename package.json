{
  "name": "whatsapp-message-scheduler",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start --filter=@app/server",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "turbo run typecheck test && oxlint && oxfmt --check",
    "db:generate": "turbo run db:generate --filter=@app/server",
    "db:migrate": "turbo run db:migrate --filter=@app/server",
    "db:studio": "turbo run db:studio --filter=@app/server",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3"
  }
}
