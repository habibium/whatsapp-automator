{
  "name": "whatsapp-message-scheduler",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "packageManager": "bun@1.3.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@app/server --filter=@app/web",
    "dev:server": "turbo run dev --filter=@app/server",
    "dev:web": "turbo run dev --filter=@app/web",
    "build": "turbo run build",
    "build:server": "turbo run build --filter=@app/server",
    "build:web": "turbo run build --filter=@app/web",
    "start": "turbo run start --filter=@app/server",
    "start:server": "turbo run start --filter=@app/server",
    "start:web": "turbo run start --filter=@app/web",
    "db:generate": "turbo run db:generate --filter=@app/server",
    "db:migrate": "turbo run db:migrate --filter=@app/server",
    "clean": "turbo run clean && rm -rf .turbo",
    "biome": "biome check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
