# Database connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whatsapp_scheduler"

# Better Auth public origin (use the frontend/tunnel origin when the frontend proxies /api)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:5173"

# SMTP — Gmail
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Frontend (Vite)
# Use /api to keep the browser on the frontend origin in dev/tunneled setups.
VITE_API_URL="/api"
# Optional: override the local backend that Vite proxies /api to in dev mode.
VITE_DEV_PROXY_TARGET="http://localhost:3000"
# Frontend public origin used for email links and tunneled access.
APP_URL="http://localhost:5173"

# Additional CORS origins (comma-separated, optional)
# CORS_ORIGINS="http://localhost:5173,https://your-frontend-tunnel.trycloudflare.com"
