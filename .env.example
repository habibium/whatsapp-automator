DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/whatsapp_automator
# optional, defaults shown
# PORT=8000
# WEB_DIR=web/dist
# RUST_LOG=info,server=debug,tower_http=debug
# Release builds require APP_URL; debug builds default to the Vite dev server
# APP_URL=http://localhost:5173
# Without SMTP_URL, emails (and the links in them) are written to the server log.
# An https APP_URL requires SMTP_URL.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# EMAIL_FROM=WhatsApp Automator <no-reply@example.com>
# Encrypts secrets in the database, such as authenticator app keys. Release builds require it;
# debug builds fall back to a well-known development key. Generate one with:
#   openssl rand -base64 32
# ENCRYPTION_KEY=
